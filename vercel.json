{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "ignoreCommand": "git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\" 2>/dev/null && git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude).github/**' ':(exclude)docs/**' || git diff --quiet HEAD^ HEAD -- . ':(exclude).github/**' ':(exclude)docs/**'",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "rewrites": [
    {
      "source": "/brand/zhaowu-logo-r59.png",
      "destination": "https://plgpxusmemnmzckbwtiv.supabase.co/storage/v1/object/public/zhaowu-backgrounds/brand/r59/zhaowu-logo.png"
    },
    {
      "source": "/apple-touch-icon-r59.png",
      "destination": "https://plgpxusmemnmzckbwtiv.supabase.co/storage/v1/object/public/zhaowu-backgrounds/brand/r59/zhaowu-home-icon-180.png"
    },
    {
      "source": "/apple-touch-icon-r59-precomposed.png",
      "destination": "https://plgpxusmemnmzckbwtiv.supabase.co/storage/v1/object/public/zhaowu-backgrounds/brand/r59/zhaowu-home-icon-180.png"
    },
    {
      "source": "/icons/zhaowu-lotus-r59-192.png",
      "destination": "https://plgpxusmemnmzckbwtiv.supabase.co/storage/v1/object/public/zhaowu-backgrounds/brand/r59/zhaowu-home-icon-192.png"
    },
    {
      "source": "/icons/zhaowu-lotus-r59-512.png",
      "destination": "https://plgpxusmemnmzckbwtiv.supabase.co/storage/v1/object/public/zhaowu-backgrounds/brand/r59/zhaowu-home-icon-512.png"
    },
    {
      "source": "/api/gallery-ingest-finalize",
      "destination": "https://plgpxusmemnmzckbwtiv.supabase.co/functions/v1/gallery-ingest-finalize"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
