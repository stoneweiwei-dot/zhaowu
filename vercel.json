{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "ignoreCommand": "[ \"${VERCEL_GIT_COMMIT_REF:-main}\" != main ] && exit 0; git cat-file -e \"$VERCEL_GIT_PREVIOUS_SHA^{commit}\"&&git diff --quiet \"$VERCEL_GIT_PREVIOUS_SHA\" HEAD -- . ':(exclude).github/**' ':(exclude)docs/**' ':(exclude)e2e/**'||false",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/",
      "headers": [ { "key": "Cache-Control", "value": "no-store, max-age=0" } ]
    },
    {
      "source": "/index.html",
      "headers": [ { "key": "Cache-Control", "value": "no-store, max-age=0" } ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [ { "key": "Cache-Control", "value": "no-store, max-age=0" } ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/gallery-ingest-finalize",
      "destination": "https://plgpxusmemnmzckbwtiv.supabase.co/functions/v1/gallery-ingest-finalize"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
