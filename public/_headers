/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob: https://esm.sh https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' blob: data: https://gyisxbkjzvdretbqzeuw.supabase.co https://api.open-meteo.com https://geocoding-api.open-meteo.com https://photon.komoot.io https://us.i.posthog.com https://esm.sh https://cdn.jsdelivr.net; worker-src 'self' blob:; manifest-src 'self'; frame-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'
  Strict-Transport-Security: max-age=63072000; includeSubDomains

/sw.js
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0
  Service-Worker-Allowed: /

/release.json
  Cache-Control: no-store, no-cache, must-revalidate, max-age=0

/
  Cache-Control: no-store, max-age=0

/index.html
  Cache-Control: no-store, max-age=0

/manifest*.webmanifest
  Cache-Control: no-store, max-age=0

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/sb/storage/v1/object/public/*
  Cache-Control: public, max-age=86400, s-maxage=86400, stale-while-revalidate=604800

/audio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/tea-guardians/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/report-visuals/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/ornaments/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/gallery/loading/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/member*
  X-Robots-Tag: noindex, nofollow
/login*
  X-Robots-Tag: noindex, nofollow
/account*
